{
  "name": "delivery",
  "prerequisites": ["deployment"],
  "agents": ["release-readiness-agent", "git-release-agent"],
  "rules": ["rules/common.md", "rules/phases/delivery.md"],
  "inputs": ["PRD.md", "docs/PRD.md", "TRD.md", "docs/TRD.md", "UI_UX_SPEC.md", "docs/UI_UX_SPEC.md", "BACKEND_SPEC.md", "docs/BACKEND_SPEC.md", "DELIVERY_SPEC.md", "docs/DELIVERY_SPEC.md", "docs/generated/requirements.json", "docs/api/**", ".ai/evidence/**", ".ai/issues/**", "artifacts/tests/**", "artifacts/security/**"],
