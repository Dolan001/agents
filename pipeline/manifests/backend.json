{
  "name": "backend",
  "prerequisites": ["mobile"],
  "agents": ["selected-backend-agent", "selected-backend-verifier"],
  "rules": ["rules/common.md", "rules/phases/backend.md"],
  "inputs": ["docs/generated/requirements.json", "docs/api/**", "apps/backend/**"],
