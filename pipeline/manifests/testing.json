{
  "name": "testing",
  "prerequisites": ["integration"],
  "agents": ["test-triage-agent", "e2e-test-agent", "security-reviewer", "feature-verification-agent"],
  "rules": ["rules/common.md", "rules/phases/testing.md"],
  "inputs": ["PRD.md", "docs/PRD.md", "TRD.md", "docs/TRD.md", "UI_UX_SPEC.md", "docs/UI_UX_SPEC.md", "BACKEND_SPEC.md", "docs/BACKEND_SPEC.md", "DELIVERY_SPEC.md", "docs/DELIVERY_SPEC.md", "docs/generated/requirements.json", "docs/api/**", "apps/**", "packages/**", "tests/**"],
  "outputs": ["artifacts/tests/**", "artifacts/security/**", ".ai/evidence/features/**"],
  "scope": {"application_writes": false, "allowed_paths": ["tests/**", "artifacts/**", ".ai/evidence/**"]},
  "gate": "gates/contracts/testing.json"
}
