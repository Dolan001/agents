{
  "version": "1.0.0",
  "copy_application_source": false,
  "packs": {
    "django-drf": {
      "path": "drf",
      "role": "backend",
      "target": "apps/backend"
    },
    "fastapi": {
      "path": "fastapi",
      "role": "backend",
      "target": "apps/backend"
    },
    "flutter": {
      "path": "flutter",
      "role": "mobile",
      "target": "apps/mobile"
    },
    "nextjs": {
      "path": "nextjs",
      "role": "frontend",
      "target": "apps/frontend"
    },
    "react": {
      "path": "react",
      "role": "frontend",
      "target": "apps/frontend"
    }
  },
  "capability_packs": {
    "rag": {
      "path": "rag",
      "activation": "explicit-prd-capability",
      "phases": ["requirements", "frontend", "mobile", "backend", "integration", "testing"]
    },
    "webscraping": {
      "path": "webscraping",
      "activation": "explicit-prd-capability",
      "backend_only": true,
      "requires": ["django-drf-or-fastapi", "postgresql", "celery", "redis"],
      "phases": ["requirements", "backend", "integration", "testing"]
    }
  }
}
