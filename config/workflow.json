{
  "version": "1.0.0",
  "phases": [
    "bootstrap", "requirements", "design", "frontend", "backend", "integration",
    "testing", "delivery"
  ],
  "maximum_retries_per_failure": 2,
  "maximum_context_files": 20,
  "maximum_changed_files_per_task": 30,
  "protected_branches": [
    "main", "master", "dev", "develop", "stage", "staging", "production", "prod"
  ],
  "remote_push_enabled_by_default": false
}

