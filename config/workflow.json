{
  "version": "1.0.0",
  "phases": [
    "bootstrap", "requirements", "design", "frontend", "backend", "integration",
    "testing", "delivery"
  ],
  "maximum_retries_per_failure": 2,
  "maximum_context_files": 12,
  "maximum_context_characters": 60000,
  "maximum_changed_files_per_task": 30,
  "maximum_parallel_tasks": 3,
  "parallelism_requires_disjoint_path_leases": true,
  "reuse_verified_nodes_by_input_hash": true,
  "verification_lanes": ["fast", "full"],
  "protected_branches": [
    "main", "master", "dev", "develop", "stage", "staging", "production", "prod"
  ],
  "remote_push_enabled_by_default": false
}
