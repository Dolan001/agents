{
  "version": 1,
  "adapters": {
    "codex": {"argv": ["codex", "exec", "--sandbox", "workspace-write", "--ephemeral", "-"], "prompt_transport": "stdin"},
    "codex-reviewed": {"argv": ["codex", "exec", "--approve-for-me", "-"], "prompt_transport": "stdin"},
    "claude": {"argv": ["claude", "--print", "--permission-mode", "auto", "--no-session-persistence"], "prompt_transport": "stdin"},
    "opencode": {"argv": ["opencode", "run"], "prompt_transport": "stdin"},
    "gemini": {"argv": ["gemini", "--prompt", "Follow the workflow instructions supplied on standard input."], "prompt_transport": "stdin"}
  },
  "timeout_seconds": 3600
}
