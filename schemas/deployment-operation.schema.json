{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Deployment operation evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "provider", "environment", "operation", "verified", "source_commit",
    "artifact_digest", "deployment_id", "account_id", "region", "checks", "checked_at"
  ],
  "properties": {
    "provider": {"const": "aws"},
    "environment": {"enum": ["staging", "production"]},
    "operation": {"enum": ["deploy", "rollback"]},
    "verified": {"const": true},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "artifact_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "deployment_id": {"type": "string", "minLength": 1},
    "account_id": {"type": "string", "pattern": "^[0-9]{12}$"},
    "region": {"type": "string", "pattern": "^[a-z]{2}(?:-gov)?-[a-z]+-[0-9]+$"},
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "passed"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "passed": {"const": true}
        }
      }
    },
    "checked_at": {"type": "string", "format": "date-time"}
  }
}
