{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "algorithm", "reference_sha256", "actual_sha256", "diff_sha256", "width", "height", "total_pixels", "masked_pixels", "compared_pixels", "different_pixels", "different_ratio", "max_channel_delta", "mean_channel_delta", "difference_bbox", "channel_tolerance", "max_changed_ratio", "passed"],
  "properties": {
    "version": {"const": 1},
    "algorithm": {"const": "rgba-max-channel-v1"},
    "reference_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "actual_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "diff_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "width": {"type": "integer", "minimum": 1, "maximum": 10000},
    "height": {"type": "integer", "minimum": 1, "maximum": 10000},
    "total_pixels": {"type": "integer", "minimum": 1},
    "masked_pixels": {"type": "integer", "minimum": 0},
    "compared_pixels": {"type": "integer", "minimum": 1},
    "different_pixels": {"type": "integer", "minimum": 0},
    "different_ratio": {"type": "number", "minimum": 0, "maximum": 1},
    "max_channel_delta": {"type": "integer", "minimum": 0, "maximum": 255},
    "mean_channel_delta": {"type": "number", "minimum": 0, "maximum": 255},
    "difference_bbox": {
      "oneOf": [
        {"type": "null"},
        {"type": "array", "prefixItems": [{"type": "integer"}, {"type": "integer"}, {"type": "integer"}, {"type": "integer"}], "items": false, "minItems": 4, "maxItems": 4}
      ]
    },
    "channel_tolerance": {"type": "integer", "minimum": 0, "maximum": 8},
    "max_changed_ratio": {"type": "number", "minimum": 0, "maximum": 0.001},
    "passed": {"type": "boolean"}
  }
}
