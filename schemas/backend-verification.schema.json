{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "framework", "runtime", "api", "test_data", "transactions", "background_tasks", "openapi", "security", "client_journeys", "checks", "verified"],
  "properties": {
    "version": {"const": 1},
    "framework": {"enum": ["django-drf", "fastapi"]},
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["import_passed", "startup_passed", "readiness_passed"],
      "properties": {
        "import_passed": {"const": true},
        "startup_passed": {"const": true},
        "readiness_passed": {"const": true}
      }
    },
    "api": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_passed", "live_http_passed", "database_round_trip_passed", "success_and_negative_passed", "authorization_passed"],
      "properties": {
        "contract_passed": {"const": true},
        "live_http_passed": {"const": true},
        "database_round_trip_passed": {"const": true},
        "success_and_negative_passed": {"const": true},
        "authorization_passed": {"const": true}
      }
    },
    "test_data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dataset_version", "provenance", "records_created", "cleanup_passed"],
      "properties": {
        "dataset_version": {"type": "string", "minLength": 1},
        "provenance": {"const": "deterministic-synthetic-seed"},
        "records_created": {"type": "integer", "minimum": 1},
        "cleanup_passed": {"const": true}
      }
    },
    "transactions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "concurrency_cases"],
      "properties": {
        "passed": {"const": true},
        "concurrency_cases": {"type": "integer", "minimum": 1}
      }
    },
    "background_tasks": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["required"],
          "properties": {"required": {"const": false}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "required", "broker", "broker_connection_passed", "worker_startup_passed",
            "enqueue_consume_passed", "retry_passed", "idempotency_passed",
            "duplicate_delivery_passed", "outbox_passed", "dead_letter_passed",
            "scheduling_required", "scheduling_passed"
          ],
          "properties": {
            "required": {"const": true},
            "broker": {"const": "redis"},
            "broker_connection_passed": {"const": true},
            "worker_startup_passed": {"const": true},
            "enqueue_consume_passed": {"const": true},
            "retry_passed": {"const": true},
            "idempotency_passed": {"const": true},
            "duplicate_delivery_passed": {"const": true},
            "outbox_passed": {"const": true},
            "dead_letter_passed": {"const": true},
            "scheduling_required": {"type": "boolean"},
            "scheduling_passed": {"type": ["boolean", "null"]}
          },
          "allOf": [
            {
              "if": {"properties": {"scheduling_required": {"const": true}}},
              "then": {"properties": {"scheduling_passed": {"const": true}}},
              "else": {"properties": {"scheduling_passed": {"const": null}}}
            }
          ]
        }
      ]
    },
    "openapi": {"type": "object", "additionalProperties": false, "required": ["passed"], "properties": {"passed": {"const": true}}},
    "security": {"type": "object", "additionalProperties": false, "required": ["passed"], "properties": {"passed": {"const": true}}},
    "client_journeys": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["requirement_id", "action", "operation_ids", "live_check"],
        "properties": {
          "requirement_id": {"type": "string", "pattern": "^[A-Z]+-[0-9]{3}$"},
          "action": {"type": "string", "minLength": 3},
          "operation_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "live_check": {"type": "string", "minLength": 1},
          "upload_round_trip": {
            "type": "object",
            "additionalProperties": false,
            "required": ["storage_service", "client_reachable", "upload_status", "read_status", "server_observed_metadata", "sha256_verified"],
            "properties": {
              "storage_service": {"type": "string", "minLength": 1},
              "client_reachable": {"const": true},
              "upload_status": {"type": "integer", "minimum": 200, "maximum": 299},
              "read_status": {"type": "integer", "minimum": 200, "maximum": 299},
              "server_observed_metadata": {"const": true},
              "sha256_verified": {"const": true}
            }
          }
        },
        "allOf": [{
          "if": {"properties": {"action": {
            "pattern": "[Uu]pload|[Ss]elect[^.]*[Ff]ile|[Ss]elect[^.]*[Pp]icture|[Aa]ttach[^.]*[Ff]ile"
          }}},
          "then": {"required": ["upload_round_trip"]}
        }]
      }
    },
    "checks": {
      "type": "array",
      "minItems": 9,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "argv", "cwd", "exit_code"],
        "properties": {
          "name": {"enum": ["import", "startup", "seed-data", "api-live", "api", "authorization", "transactions", "broker", "worker", "tasks", "openapi", "security", "client-journey-contract"]},
          "argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "cwd": {"type": "string", "minLength": 1, "not": {"pattern": "(^/|(^|/)\\.\\.(/|$))"}},
          "exit_code": {"const": 0}
        }
      },
      "allOf": [
        {"contains": {"properties": {"name": {"const": "import"}}, "required": ["name"]}},
        {"contains": {"properties": {"name": {"const": "startup"}}, "required": ["name"]}},
        {"contains": {"properties": {"name": {"const": "seed-data"}}, "required": ["name"]}},
        {"contains": {"properties": {"name": {"const": "api-live"}}, "required": ["name"]}},
        {"contains": {"properties": {"name": {"const": "api"}}, "required": ["name"]}},
        {"contains": {"properties": {"name": {"const": "authorization"}}, "required": ["name"]}},
        {"contains": {"properties": {"name": {"const": "transactions"}}, "required": ["name"]}},
        {"contains": {"properties": {"name": {"const": "openapi"}}, "required": ["name"]}},
        {"contains": {"properties": {"name": {"const": "security"}}, "required": ["name"]}},
        {"contains": {"properties": {"name": {"const": "client-journey-contract"}}, "required": ["name"]}}
      ]
    },
    "verified": {"const": true}
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "background_tasks": {
            "properties": {"required": {"const": true}},
            "required": ["required"]
          }
        },
        "required": ["background_tasks"]
      },
      "then": {
        "properties": {
          "checks": {
            "minItems": 12,
            "allOf": [
              {"contains": {"properties": {"name": {"const": "broker"}}, "required": ["name"]}},
              {"contains": {"properties": {"name": {"const": "worker"}}, "required": ["name"]}},
              {"contains": {"properties": {"name": {"const": "tasks"}}, "required": ["name"]}}
            ]
          }
        }
      }
    }
  ]
}
