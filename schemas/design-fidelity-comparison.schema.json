{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "target", "framework", "baseline_sha256", "mode", "aligned", "findings", "accepted_differences", "changed_paths", "summary", "verified", "checked_at"],
  "properties": {
    "version": {"const": 1},
    "target": {"enum": ["frontend", "mobile"]},
    "framework": {"enum": ["react", "nextjs", "flutter"]},
    "baseline_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "mode": {"enum": ["check-only", "repair"]},
    "aligned": {"type": "boolean"},
    "findings": {
      "type": "array",
      "items": {"$ref": "#/$defs/finding"}
    },
    "accepted_differences": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "category", "justification"],
        "properties": {
          "case_id": {"type": "string", "pattern": "^DF-CASE-[A-Z0-9-]+$"},
          "category": {"enum": ["prd-requirement", "accessibility", "native-platform-convention"]},
          "justification": {"type": "string", "minLength": 10}
        }
      }
    },
    "changed_paths": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "not": {"pattern": "(^/|(^|/)\\.\\.(/|$))"}}
    },
    "summary": {"type": "string", "minLength": 10},
    "verified": {"type": "boolean"},
    "checked_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {
      "if": {"properties": {"aligned": {"const": true}}, "required": ["aligned"]},
      "then": {"properties": {"findings": {"maxItems": 0}, "verified": {"const": true}}},
      "else": {"properties": {"findings": {"minItems": 1}, "verified": {"const": false}}}
    },
    {
      "if": {"properties": {"mode": {"const": "check-only"}}, "required": ["mode"]},
      "then": {"properties": {"changed_paths": {"maxItems": 0}}}
    }
  ],
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "case_id", "severity", "category", "expected", "actual", "requirement_ids", "affected_paths", "evidence"],
      "properties": {
        "id": {"type": "string", "pattern": "^DF-[0-9]{3,}$"},
        "case_id": {"type": "string", "pattern": "^DF-CASE-[A-Z0-9-]+$"},
        "severity": {"enum": ["blocker", "major", "minor"]},
        "category": {"enum": ["content", "structure", "layout", "spacing", "typography", "color", "imagery", "responsive", "state", "accessibility", "interaction", "platform-adaptation", "baseline-defect"]},
        "expected": {"type": "string", "minLength": 5},
        "actual": {"type": "string", "minLength": 5},
        "requirement_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "affected_paths": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^\\.ai/evidence/design-fidelity/(frontend|mobile)/"}}
      }
    }
  }
}
