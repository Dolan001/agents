{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "commands"],
  "properties": {
    "version": {"const": 1},
    "commands": {
      "type": "object",
      "required": ["backend", "generate-client", "contract", "integration", "e2e"],
      "anyOf": [{"required": ["frontend"]}, {"required": ["mobile"]}],
      "additionalProperties": false,
      "patternProperties": {
        "^(frontend|mobile|backend|generate-client|contract|integration|e2e)$": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["argv", "cwd"],
            "properties": {
              "argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
              "cwd": {"type": "string", "not": {"pattern": "(^/|(^|/)\\.\\.(/|$))"}},
              "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 7200}
            }
          }
        }
      }
    }
  }
}
